<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- Tauri v1.6 WiX template with perUser + LocalAppDataFolder surgical changes -->
  <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited" />
  <Media Id="1" Cabinet="product.cab" EmbedCab="yes" />
  <Directory Id="TARGETDIR" Name="SourceDir">
    <Directory Id="LocalAppDataFolder" Name="LocalAppData">
      <Directory Id="INSTALLDIR" Name="Barangay ID Registration System">
        <!-- App files -->
      </Directory>
    </Directory>
    <Directory Id="DesktopFolder" Name="Desktop" />
  </Directory>
  <Feature Id="ProductFeature" Title="Barangay ID System" Level="1">
    <ComponentRef Id="ApplicationShortcutDesktop" />
    <ComponentRef Id="MainExecutable" />
  </Feature>
  <Component Id="ApplicationShortcutDesktop" Directory="DesktopFolder" Guid="*">
    <Shortcut Id="ApplicationShortcutDesktop" Name="Barangay ID System" Target="[INSTALLDIR]Barangay ID Registration System.exe" WorkingDirectory="INSTALLDIR" />
    <RemoveFolder Id="CleanUpDesktop" Directory="DesktopFolder" On="uninstall" />
    <RegistryValue Root="HKCU" Key="Software\BarangayIDSystem" Name="installed" Type="integer" Value="1" KeyPath="yes" />
  </Component>
</Wix>
